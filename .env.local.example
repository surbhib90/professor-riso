# Copy to .env.local and fill in. Never commit .env.local — it's gitignored.

# Tavus API key. Get one at maker.tavus.io/dev/api-keys.
TAVUS_API_KEY=

# Printed by `node scripts/setup-tavus.mjs` after provisioning the PAL, tools,
# and objectives graph. Paste both values it gives you.
TAVUS_PAL_ID=
TAVUS_REPLICA_ID=

# Optional: comma-separated Tavus document IDs to ground the PAL's
# explanations via Knowledge Base (RAG). Read at PAL-creation time by
# setup-tavus.mjs — re-provisioning is the only way to change this once set.
TAVUS_DOCUMENT_IDS=

# Supabase project URL and anon (public) key. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key, used only to check whether a student's mid-session
# upload (app/api/knowledge/upload) is actually about the topic they're
# working on before it's added to the Tavus knowledge base. Get one at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Supabase service role key (Project Settings -> API -> service_role, secret).
# Bypasses RLS — used only by server-to-server webhooks with no Supabase user
# session to bind (see lib/supabase/service.ts): /api/tavus/session-summary
# and /api/cron/webhook-health.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret baked into the Tavus callback_url's ?key= query param
# (see lib/tavus/webhook-url.ts) — substitutes for signature verification,
# which Tavus's webhooks don't support. Any random string; generate with
# `openssl rand -hex 32`.
TAVUS_WEBHOOK_SECRET=

# This app's own public URL, used to build the callback_url Tavus posts
# webhook events to. No trailing slash, no trailing newline — a stray \n
# here broke webhook delivery silently in prod on 2026-07-30.
PUBLIC_APP_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when invoking /api/cron/webhook-health. Any random string; generate with
# `openssl rand -hex 32`.
CRON_SECRET=

# Slack incoming-webhook URL for /api/cron/webhook-health alerts. Optional —
# if unset, the route logs to console instead of posting to Slack.
SLACK_WEBHOOK_URL=
