# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# provisioned Tavus resource ids (written by scripts/setup-tavus.mjs)
.tavus-ids.json

# generated by scripts/seed-prefill.mjs — regenerate, don't hand-edit
supabase/seed-prefill-*.sql

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# spike scratch: holds a live conversation id, regenerated per run
spike/test-conversation.json

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# brainstorming visual companion (superpowers skill scratch)
.superpowers/

# git worktree fallback location (superpowers:using-git-worktrees)
.worktrees/
